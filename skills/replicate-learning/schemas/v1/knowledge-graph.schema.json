{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/knowledge-graph.schema.json",
  "title": "Project DeepDive v1 Knowledge Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "repository_revision", "generated_at", "nodes", "edges"],
  "properties": {
    "artifact_kind": {"const": "knowledge-graph"},
    "schema_version": {"const": "1.0.0"},
    "repository_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "evidence_ids", "properties"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["Project", "RepositorySurface", "Module", "File", "Symbol", "BusinessCapability", "BusinessWorkflow", "RuntimeWorkflow", "Feature", "API", "DataModel", "Dependency", "Framework", "Mechanism", "Concept", "Prerequisite", "Evidence", "Claim", "Test", "ExtensionPoint", "FailureMode", "InterviewTopic"]},
          "label": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "properties": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "from", "to", "status", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["CALLS", "CALLED_BY", "DEPENDS_ON", "IMPLEMENTS", "EXTENDS", "USES", "ROUTES_TO", "READS", "WRITES", "PERSISTS_TO", "PUBLISHES", "CONSUMES", "RENDERS", "TRIGGERS", "PART_OF", "REQUIRES_CONCEPT", "EVIDENCED_BY", "TESTED_BY", "EXTENSION_OF", "FAILS_WHEN"]},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "status": {"enum": ["VERIFIED", "INFERRED", "UNKNOWN"]},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
