{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/stack-profile.schema.json",
  "title": "Project DeepDive v1 Stack Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "repository_revision", "generated_at", "detections"],
  "properties": {
    "artifact_kind": {"const": "stack-profile"},
    "schema_version": {"const": "1.0.0"},
    "repository_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "name", "status", "confidence", "evidence_ids"],
        "properties": {
          "category": {"enum": ["language", "framework", "build", "package_manager", "database", "frontend", "infrastructure", "testing", "tooling"]},
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["VERIFIED", "LIKELY", "UNKNOWN"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
