{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/evidence.schema.json",
  "title": "Project DeepDive v1 Evidence Store",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "repository_revision", "generated_at", "items"],
  "properties": {
    "artifact_kind": {"const": "evidence"},
    "schema_version": {"const": "1.0.0"},
    "repository_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "kind", "summary", "confidence", "locator"],
        "properties": {
          "id": {"type": "string", "pattern": "^EVID-[A-Za-z0-9._:-]+$"},
          "level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"]},
          "kind": {"enum": ["user", "source", "config", "dependency", "test", "runtime", "official_documentation", "history", "issue", "inference"]},
          "summary": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "symbol": {"type": "string", "minLength": 1},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "command": {"type": "string", "minLength": 1},
              "observation": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
