{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/whole-book-assembly.schema.json",
  "title": "Project DeepDive Whole-Book Assembly Manifest",
  "description": "Explicit selection and deterministic output bindings for one D3a draft assembly; no quality promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind", "schema_version", "repository_revision", "generated_at", "assembly_id",
    "run_plan_id", "run_plan_sha256", "run_state_id", "run_state_revision", "run_state_sha256",
    "run_state_schema_version", "snapshot_kind", "source_metadata", "source_status",
    "source_run_manifest_sha256", "unknown_files", "curriculum_schema_version", "curriculum_sha256",
    "input_digests", "unit_count", "selected_count", "units", "lesson_status",
    "answer_book_status", "overall_status", "cross_chapter_audit", "outputs"
  ],
  "properties": {
    "artifact_kind": {"const": "whole-book-assembly"},
    "schema_version": {"const": "1.0.0"},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "assembly_id": {"type": "string", "pattern": "^WHOLE-BOOK-ASSEMBLY-[0-9a-f]{64}$"},
    "run_plan_id": {"type": "string", "pattern": "^CURRICULUM-RUN-PLAN-[0-9a-f]{64}$"},
    "run_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_state_id": {"type": "string", "pattern": "^CURRICULUM-RUN-STATE-[0-9a-f]{64}$"},
    "run_state_revision": {"type": "integer", "minimum": 1},
    "run_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_state_schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_kind", "g01_status", "unknown_files", "project_index_sha256", "coverage_sha256"],
      "properties": {
        "snapshot_kind": {"enum": ["worktree", "git-tree"]},
        "g01_status": {"enum": ["PASS", "PARTIAL"]},
        "unknown_files": {"type": "integer", "minimum": 0},
        "project_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_status": {"enum": ["PASS", "PARTIAL"]},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknown_files": {"type": "integer", "minimum": 0},
    "curriculum_schema_version": {"enum": ["1.1.0", "1.2.0"]},
    "curriculum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_digests": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["role", "artifact_kind", "schema_version", "sha256"],
        "properties": {
          "role": {"enum": ["phase4_base_graph", "phase4_base_evidence", "phase4_semantic_proposals", "phase4_claim_candidates", "phase4_claim_evidence", "phase4_claim_evidence_graph", "phase5_prerequisite_candidates", "phase5_prerequisite_graph", "phase5_curriculum_candidates", "phase5_curriculum"]},
          "artifact_kind": {"enum": ["knowledge-graph", "evidence", "semantic-proposals", "claim-candidates", "claim-evidence", "claim-evidence-graph", "prerequisite-candidates", "prerequisite-graph", "curriculum-candidates", "curriculum"]},
          "schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "unit_count": {"type": "integer", "minimum": 2},
    "selected_count": {"type": "integer", "minimum": 1},
    "units": {
      "type": "array", "minItems": 2,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["position", "unit_id", "unit_identity", "unit_identity_sha256", "route", "plan_state", "reason_codes", "blocked_by", "prerequisite_ids", "execution_state", "selection_state", "attempt_id", "review_state", "review_status_sha256", "artifact_digests", "answer_status"],
        "properties": {
          "position": {"type": "integer", "minimum": 1},
          "unit_id": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"},
          "unit_identity": {"type": "object", "additionalProperties": true},
          "unit_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "route": {"enum": ["D2A_GENERAL_LEARNING", "PHASE6A_PROJECT_CLAIM", "UPSTREAM_REQUIRED", "BLOCKED_UNSUPPORTED"]},
          "plan_state": {"enum": ["PLANNED", "BLOCKED"]},
          "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "blocked_by": {"type": "array", "items": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"}},
          "prerequisite_ids": {"type": "array", "items": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"}},
          "execution_state": {"type": "string", "minLength": 1},
          "selection_state": {"enum": ["SELECTED", "NOT_SELECTED"]},
          "attempt_id": {"type": ["string", "null"], "pattern": "^attempt-000[123]$"},
          "review_state": {"type": ["string", "null"], "enum": ["REVIEWED_DRAFT", null]},
          "review_status_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "artifact_digests": {"type": "array", "items": {"type": "object", "additionalProperties": false,
            "required": ["role", "relative_path", "sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "relative_path": {"type": "string", "pattern": "^units/[0-9]{4}/attempt-000[123]/[^/]+/[^/]+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }},
          "answer_status": {"enum": ["INCLUDED", "NOT_SUPPLIED", "NOT_APPLICABLE", "NOT_SELECTED"]},
          "project_answer": {"type": ["object", "null"], "additionalProperties": false,
            "required": ["candidate_sha256", "exercise_bank_sha256", "answer_book_sha256", "d1b_review_state", "d1b_status_sha256", "d1b_evidence_report_sha256", "d1b_beginner_report_sha256"],
            "properties": {
              "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "exercise_bank_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "answer_book_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "d1b_review_state": {"enum": ["REVIEWED_DRAFT", "NOT_RUN"]},
              "d1b_status_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "d1b_evidence_report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "d1b_beginner_report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "lesson_status": {"const": "DRAFT"},
    "answer_book_status": {"const": "DRAFT"},
    "overall_status": {"const": "PARTIAL"},
    "cross_chapter_audit": {"const": "NOT_RUN"},
    "outputs": {"type": "array", "minItems": 3, "maxItems": 3,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"enum": ["whole_book", "answer_book", "quality_and_gaps"]},
          "path": {"enum": ["WHOLE-BOOK.md", "WHOLE-ANSWER-BOOK.md", "QUALITY-AND-GAPS.md"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
