{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/chapter-review-session.schema.json",
  "title": "Project DeepDive Phase 6B1 Chapter Review Session",
  "description": "Round-zero binding for two separately prepared reviews of one immutable Phase 6A draft.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "review_session_id", "review_round", "repository_revision", "generated_at", "snapshot_kind", "source_metadata", "source_status", "source_run_manifest_sha256", "unknown_files", "phase3_member_digests", "input_digests", "writer_alias", "prompt_versions", "chapter_id", "chapter_sha256", "chapter_facts_sha256", "exercise_bank_sha256", "phase6a_status_sha256", "evidence_packet_sha256", "beginner_packet_sha256"],
  "properties": {
    "artifact_kind": {"const": "chapter-review-session"},
    "schema_version": {"const": "1.0.0"},
    "review_session_id": {"type": "string", "pattern": "^REVIEW-[0-9a-f]{64}$"},
    "review_round": {"const": 0},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_kind", "g01_status", "unknown_files", "project_index_sha256", "coverage_sha256"],
      "properties": {
        "snapshot_kind": {"enum": ["worktree", "git-tree"]},
        "g01_status": {"enum": ["PASS", "PARTIAL"]},
        "unknown_files": {"type": "integer", "minimum": 0},
        "project_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_status": {"enum": ["PASS", "PARTIAL"]},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknown_files": {"type": "integer", "minimum": 0},
    "phase3_member_digests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "artifact_kind", "schema_version", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "artifact_kind": {"type": "string", "minLength": 1},
          "schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "input_digests": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "artifact_kind", "schema_version", "sha256"],
        "properties": {
          "role": {"enum": ["phase4_base_graph", "phase4_base_evidence", "phase4_semantic_proposals", "phase4_claim_candidates", "phase4_claim_evidence", "phase4_claim_evidence_graph", "phase5_prerequisite_candidates", "phase5_prerequisite_graph", "phase5_curriculum_candidates", "phase5_curriculum"]},
          "artifact_kind": {"enum": ["knowledge-graph", "evidence", "semantic-proposals", "claim-candidates", "claim-evidence", "claim-evidence-graph", "prerequisite-candidates", "prerequisite-graph", "curriculum-candidates", "curriculum"]},
          "schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "writer_alias": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "prompt_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_verifier", "beginner_critic"],
      "properties": {"evidence_verifier": {"const": "1.0.0"}, "beginner_critic": {"const": "1.0.0"}}
    },
    "chapter_id": {"type": "string", "pattern": "^CHAPTER-[0-9a-f]{64}$"},
    "chapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chapter_facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exercise_bank_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase6a_status_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "beginner_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
