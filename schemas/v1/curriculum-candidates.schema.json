{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/curriculum-candidates.schema.json",
  "title": "Project DeepDive v1.0 Curriculum Candidates",
  "description": "Unordered, explicit Phase 5B outline candidates bound to the exact authenticated Phase 4C and Phase 5A inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "repository_revision",
    "generated_at",
    "phase4_inputs",
    "prerequisite_inputs",
    "units"
  ],
  "properties": {
    "artifact_kind": {"const": "curriculum-candidates"},
    "schema_version": {"const": "1.0.0"},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "learner_profile": {"const": "BEGINNER"},
    "phase4_inputs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "artifact_kind", "schema_version", "sha256"],
        "properties": {
          "path": {"enum": ["evidence.json", "knowledge-graph.json", "semantic-proposals.json"]},
          "artifact_kind": {"enum": ["evidence", "knowledge-graph", "semantic-proposals"]},
          "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "prerequisite_inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "artifact_kind", "schema_version", "sha256"],
        "properties": {
          "path": {"enum": ["prerequisite-candidates.json", "prerequisite-graph.json"]},
          "artifact_kind": {"enum": ["prerequisite-candidates", "prerequisite-graph"]},
          "schema_version": {"const": "1.0.0"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_key",
          "stage",
          "title",
          "scope",
          "introduces_concept_keys",
          "requires_concept_keys",
          "project_refs"
        ],
        "properties": {
          "unit_key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
          "stage": {"enum": ["project-purpose", "business", "workflow", "architecture", "source", "mechanism", "failure", "vibecoding", "extension", "interview"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "scope": {"enum": ["PROJECT_SPECIFIC", "GENERAL_LEARNING"]},
          "introduces_concept_keys": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}},
          "requires_concept_keys": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}},
          "project_refs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["graph_node_ids", "graph_edge_ids", "evidence_ids", "file_paths"],
            "properties": {
              "graph_node_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "graph_edge_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "file_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
