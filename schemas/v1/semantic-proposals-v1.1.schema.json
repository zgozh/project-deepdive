{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/semantic-proposals-v1.1.schema.json",
  "title": "Project DeepDive v1.1 Semantic Proposals",
  "description": "User-supplied provisional semantic proposals bound to an exact replayed Phase 4A source pair from a documentation-aware Phase 3 run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "repository_revision",
    "generated_at",
    "snapshot_kind",
    "source_metadata",
    "source_run",
    "phase4_inputs",
    "proposals"
  ],
  "properties": {
    "artifact_kind": {"const": "semantic-proposals"},
    "schema_version": {"const": "1.1.0"},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_kind", "g01_status", "unknown_files", "project_index_sha256", "coverage_sha256"],
      "properties": {
        "snapshot_kind": {"enum": ["git-tree", "worktree"]},
        "g01_status": {"enum": ["PASS", "PARTIAL"]},
        "unknown_files": {"type": "integer", "minimum": 0},
        "project_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "schema_version", "manifest_sha256", "status", "e1_audit", "members"],
      "properties": {
        "artifact_kind": {"const": "phase3-run"},
        "schema_version": {"const": "1.1.0"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["PASS", "PARTIAL"]},
        "e1_audit": {"type": "object", "additionalProperties": true},
        "members": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "artifact_kind", "schema_version", "sha256"],
            "properties": {
              "path": {"type": "string", "pattern": "^(phase2/(project-index|coverage)\\.json|phase3a/(stack-profile|evidence)\\.json|python/(static-analysis|evidence)\\.json|java-v12/(static-analysis|evidence)\\.json|java-v13/(static-analysis|evidence)\\.json|frontend/(static-analysis|evidence)\\.json|documentation/evidence\\.json)$"},
              "artifact_kind": {"enum": ["project-index", "coverage", "stack-profile", "evidence", "static-analysis"]},
              "schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "phase4_inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "artifact_kind", "schema_version", "sha256"],
        "properties": {
          "path": {"enum": ["phase4a/evidence.json", "phase4a/knowledge-graph.json"]},
          "artifact_kind": {"enum": ["knowledge-graph", "evidence"]},
          "schema_version": {"enum": ["1.2.0", "1.4.0"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "kind", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^PROP-[0-9a-f]{64}$"},
          "category": {"enum": ["business", "architecture", "mechanism", "concept"]},
          "kind": {"enum": ["node", "edge"]},
          "label": {"type": "string", "minLength": 1},
          "node_type": {"enum": ["BusinessCapability", "BusinessWorkflow", "RuntimeWorkflow", "Mechanism", "Concept"]},
          "edge_type": {"enum": ["CALLS", "CALLED_BY", "DEPENDS_ON", "IMPLEMENTS", "EXTENDS", "USES", "ROUTES_TO", "READS", "WRITES", "PERSISTS_TO", "PUBLISHES", "CONSUMES", "RENDERS", "TRIGGERS", "PART_OF", "REQUIRES_CONCEPT", "EVIDENCED_BY", "TESTED_BY", "EXTENSION_OF", "FAILS_WHEN"]},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
