{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/development-plan.schema.json",
  "title": "Project DeepDive v1 Development Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "repository_revision",
    "generated_at",
    "lab_id",
    "title",
    "project_context",
    "prerequisites",
    "current_workflow",
    "requirement",
    "decisions",
    "evidence_refs",
    "impact",
    "checks",
    "slices",
    "stages",
    "enterprise_hardening",
    "interview_followup",
    "implementation_status",
    "verification_status",
    "review_status"
  ],
  "properties": {
    "artifact_kind": {
      "const": "development-plan"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "repository_revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "lab_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "project_context": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "prerequisites": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "current_workflow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "actors",
        "in_scope",
        "out_of_scope",
        "acceptance"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "actors": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "in_scope": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "out_of_scope": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "input",
              "expected"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "expected": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "rationale",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decision": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "call_chain",
        "existing_files",
        "planned_new_files"
      ],
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "call_chain": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "existing_files": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "planned_new_files": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "cwd",
          "command",
          "expected",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "depends_on",
          "allowed_existing",
          "allowed_new",
          "protected",
          "interfaces",
          "tests",
          "risks",
          "done",
          "acceptance_refs",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "depends_on": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "allowed_existing": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "allowed_new": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "protected": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "interfaces": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "tests": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "risks": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "done": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "acceptance_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "explanation",
          "learner_actions",
          "agent_actions",
          "prompt",
          "checks",
          "gate",
          "failure_recovery"
        ],
        "properties": {
          "name": {
            "enum": [
              "BASELINE",
              "DISCOVER",
              "SPEC",
              "PLAN",
              "SLICE",
              "BUILD",
              "VERIFY",
              "REVIEW",
              "REPAIR",
              "FULL-CHAIN",
              "RETRO"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "learner_actions": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "agent_actions": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "prompt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "goal",
              "context",
              "constraints",
              "scope",
              "evidence",
              "verification",
              "done_when",
              "output_contract"
            ],
            "properties": {
              "goal": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "context": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "constraints": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "verification": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "done_when": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "output_contract": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "checks": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "gate": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "failure_recovery": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "enterprise_hardening": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "interview_followup": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "implementation_status": {
      "const": "NOT_RUN"
    },
    "verification_status": {
      "const": "NOT_RUN"
    },
    "review_status": {
      "const": "PENDING"
    }
  }
}
