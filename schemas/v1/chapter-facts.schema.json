{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/chapter-facts.schema.json",
  "title": "Project DeepDive Phase 6A Chapter Facts",
  "description": "Compact source-authenticated chapter facts with no claim prose or evidence summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "repository_revision", "generated_at", "snapshot_kind", "source_metadata", "source_status", "source_run_manifest_sha256", "unknown_files", "input_digests", "selected_unit", "claims", "evidence"],
  "properties": {
    "artifact_kind": {"const": "chapter-facts"},
    "schema_version": {"const": "1.0.0"},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_kind", "g01_status", "unknown_files", "project_index_sha256", "coverage_sha256"],
      "properties": {
        "snapshot_kind": {"enum": ["worktree", "git-tree"]},
        "g01_status": {"enum": ["PASS", "PARTIAL"]},
        "unknown_files": {"type": "integer", "minimum": 0},
        "project_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_status": {"enum": ["PASS", "PARTIAL"]},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknown_files": {"type": "integer", "minimum": 0},
    "input_digests": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "artifact_kind", "schema_version", "sha256"],
        "properties": {
          "role": {"enum": ["phase4_base_graph", "phase4_base_evidence", "phase4_semantic_proposals", "phase4_claim_candidates", "phase4_claim_evidence", "phase4_claim_evidence_graph", "phase5_prerequisite_candidates", "phase5_prerequisite_graph", "phase5_curriculum_candidates", "phase5_curriculum"]},
          "artifact_kind": {"enum": ["knowledge-graph", "evidence", "semantic-proposals", "claim-candidates", "claim-evidence", "claim-evidence-graph", "prerequisite-candidates", "prerequisite-graph", "curriculum-candidates", "curriculum"]},
          "schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "selected_unit": {
      "type": "object", "additionalProperties": false,
      "required": ["curriculum_unit_id", "chapter_id", "stage", "title", "scope", "prerequisite_concept_keys", "project_refs"],
      "properties": {
        "curriculum_unit_id": {"type": "string", "pattern": "^CURRICULUM-UNIT-[0-9a-f]{64}$"},
        "chapter_id": {"type": "string", "pattern": "^CHAPTER-[0-9a-f]{64}$"},
        "stage": {"enum": ["project-purpose", "business", "workflow", "architecture", "source", "mechanism", "failure", "vibecoding", "extension", "interview"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "scope": {"enum": ["PROJECT_SPECIFIC", "GENERAL_LEARNING"]},
        "prerequisite_concept_keys": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}},
        "project_refs": {
          "type": "object", "additionalProperties": false,
          "required": ["graph_node_ids", "graph_edge_ids", "evidence_ids", "file_paths"],
          "properties": {
            "graph_node_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "graph_edge_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "file_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement_sha256", "category", "critical", "disposition", "reason_codes", "resolved_evidence_levels", "evidence_ids", "graph_node_ids", "graph_edge_ids", "file_paths"],
        "properties": {
          "id": {"type": "string", "pattern": "^CLAIM-[0-9a-f]{64}$"},
          "statement_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "category": {"enum": ["project_fact", "architecture", "call_chain", "runtime", "general"]},
          "critical": {"type": "boolean"},
          "disposition": {"enum": ["SUPPORTED", "INFERENCE", "UNVERIFIED"]},
          "reason_codes": {"type": "array", "items": {"enum": ["EVIDENCE_NOT_FOUND", "GRAPH_NODE_NOT_FOUND", "GRAPH_EDGE_NOT_FOUND", "FILE_NOT_FOUND", "SYMBOL_NOT_FOUND", "NO_QUALIFYING_EVIDENCE", "E6_INFERENCE", "PROVISIONAL_EVIDENCE_NOT_CITED"]}},
          "resolved_evidence_levels": {"type": "array", "items": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"]}},
          "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVID-[A-Za-z0-9._:-]+$"}},
          "graph_node_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "graph_edge_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "file_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "level", "provisional", "locator", "source_members"],
        "properties": {
          "id": {"type": "string", "pattern": "^EVID-[A-Za-z0-9._:-]+$"},
          "level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"]},
          "provisional": {"type": "boolean"},
          "locator": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "symbol": {"type": "string", "minLength": 1},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1}
            }
          },
          "source_members": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
