{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/whole-book-consistency-audit.schema.json",
  "title": "Project DeepDive Whole-Book Consistency Audit",
  "description": "Deterministic report-only checks over one digest-bound D3a assembly.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "repository_revision", "generated_at", "audit_id", "assembly_id", "assembly_manifest_sha256", "run_plan_id", "run_plan_sha256", "run_state_id", "run_state_revision", "run_state_sha256", "run_state_schema_version", "snapshot_kind", "source_status", "source_run_manifest_sha256", "unknown_files", "curriculum_sha256", "input_digests", "selected_units", "d3a_outputs", "check_counts", "findings", "audit_status", "semantic_consistency", "glossary_review", "lesson_status", "answer_book_status", "overall_status", "report_sha256"],
  "properties": {
    "artifact_kind": {"const": "whole-book-consistency-audit"},
    "schema_version": {"const": "1.0.0"},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "audit_id": {"type": "string", "pattern": "^WHOLE-BOOK-AUDIT-[0-9a-f]{64}$"},
    "assembly_id": {"type": "string", "pattern": "^WHOLE-BOOK-ASSEMBLY-[0-9a-f]{64}$"},
    "assembly_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_plan_id": {"type": "string", "pattern": "^CURRICULUM-RUN-PLAN-[0-9a-f]{64}$"},
    "run_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_state_id": {"type": "string", "pattern": "^CURRICULUM-RUN-STATE-[0-9a-f]{64}$"},
    "run_state_revision": {"type": "integer", "minimum": 1},
    "run_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_state_schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_status": {"enum": ["PASS", "PARTIAL"]},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknown_files": {"type": "integer", "minimum": 0},
    "curriculum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_digests": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["role", "artifact_kind", "schema_version", "sha256"], "properties": {"role": {"enum": ["phase4_base_graph", "phase4_base_evidence", "phase4_semantic_proposals", "phase4_claim_candidates", "phase4_claim_evidence", "phase4_claim_evidence_graph", "phase5_prerequisite_candidates", "phase5_prerequisite_graph", "phase5_curriculum_candidates", "phase5_curriculum"]}, "artifact_kind": {"enum": ["knowledge-graph", "evidence", "semantic-proposals", "claim-candidates", "claim-evidence", "claim-evidence-graph", "prerequisite-candidates", "prerequisite-graph", "curriculum-candidates", "curriculum"]}, "schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "selected_units": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["position", "unit_id", "route", "attempt_id", "prerequisite_ids", "review_status_sha256", "chapter_facts_sha256", "answer_status", "d1b_review_state"], "properties": {"position": {"type": "integer", "minimum": 1}, "unit_id": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"}, "route": {"enum": ["D2A_GENERAL_LEARNING", "PHASE6A_PROJECT_CLAIM"]}, "attempt_id": {"type": "string", "pattern": "^attempt-000[123]$"}, "prerequisite_ids": {"type": "array", "items": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"}}, "review_status_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "chapter_facts_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "answer_status": {"enum": ["INCLUDED", "NOT_SUPPLIED", "NOT_APPLICABLE"]}, "d1b_review_state": {"type": ["string", "null"], "enum": ["REVIEWED_DRAFT", "NOT_RUN", null]}}}},
    "d3a_outputs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"], "properties": {"role": {"enum": ["whole_book", "answer_book", "quality_and_gaps"]}, "path": {"enum": ["WHOLE-BOOK.md", "WHOLE-ANSWER-BOOK.md", "QUALITY-AND-GAPS.md"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "check_counts": {"type": "object", "additionalProperties": false, "required": ["anchor_count", "toc_link_count", "same_book_fragment_count", "prerequisite_count", "claim_reference_count", "repeated_claim_id_count", "finding_count"], "properties": {"anchor_count": {"type": "integer", "minimum": 0}, "toc_link_count": {"type": "integer", "minimum": 0}, "same_book_fragment_count": {"type": "integer", "minimum": 0}, "prerequisite_count": {"type": "integer", "minimum": 0}, "claim_reference_count": {"type": "integer", "minimum": 0}, "repeated_claim_id_count": {"type": "integer", "minimum": 0}, "finding_count": {"type": "integer", "minimum": 0}}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "unit_id", "related_unit_ids", "claim_id", "fragment_sha256", "file", "line"], "properties": {"code": {"enum": ["ANCHOR_MISSING", "ANCHOR_DUPLICATE", "TOC_LINK_MISSING", "TOC_LINK_UNRESOLVED", "FRAGMENT_UNRESOLVED", "FRAGMENT_AMBIGUOUS", "PREREQUISITE_NOT_SELECTED", "PREREQUISITE_ORDER", "CLAIM_REFERENCE_UNBOUND", "CLAIM_DEFINITION_MISSING", "CLAIM_DEFINITION_DUPLICATE", "CLAIM_DEFINITION_MISMATCH", "CLAIM_BINDING_CONFLICT", "SOURCE_PARTIAL", "UNKNOWN_FILES", "ANSWER_GAP"]}, "severity": {"enum": ["ERROR", "WARNING", "INFO"]}, "unit_id": {"type": ["string", "null"], "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"}, "related_unit_ids": {"type": "array", "items": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"}}, "claim_id": {"type": ["string", "null"], "pattern": "^CLAIM-[0-9a-f]{64}$"}, "fragment_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "file": {"enum": ["WHOLE-BOOK.md", "WHOLE-ANSWER-BOOK.md", "QUALITY-AND-GAPS.md"]}, "line": {"type": ["integer", "null"], "minimum": 1}}}},
    "audit_status": {"const": "REPORT_ONLY"},
    "semantic_consistency": {"const": "NOT_RUN"},
    "glossary_review": {"const": "NOT_RUN"},
    "lesson_status": {"const": "DRAFT"},
    "answer_book_status": {"const": "DRAFT"},
    "overall_status": {"const": "PARTIAL"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
