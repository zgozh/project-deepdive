{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/answer-beginner-review.schema.json",
  "title": "Project DeepDive Phase 6D1b Answer Beginner Review",
  "description": "Reviewer-authored legibility and pedagogy findings for each prompt and answer section.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "generated_at", "review_session_id", "review_session_sha256", "review_round", "repository_revision", "snapshot_kind", "source_run_manifest_sha256", "chapter_id", "chapter_sha256", "chapter_facts_sha256", "exercise_bank_sha256", "chapter_review_session_sha256", "chapter_review_status_sha256", "answer_candidates_sha256", "answer_bank_sha256", "answer_book_sha256", "writer_alias", "reviewer_alias", "reviewer_session_id", "fresh_context_isolated", "packet_sha256", "results"],
  "properties": {
    "artifact_kind": {"const": "answer-beginner-review"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "review_session_id": {"type": "string", "pattern": "^ANSWER-REVIEW-[0-9a-f]{64}$"},
    "review_session_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_round": {"const": 0},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chapter_id": {"type": "string", "pattern": "^CHAPTER-[0-9a-f]{64}$"},
    "chapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chapter_facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exercise_bank_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chapter_review_session_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chapter_review_status_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answer_candidates_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answer_bank_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answer_book_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "writer_alias": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "reviewer_alias": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "reviewer_session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "fresh_context_isolated": {"type": "boolean"},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scope_id", "question_id", "scope_kind", "section", "fragment_occurrence_ids", "scope_sha256", "outcome", "findings"],
        "properties": {
          "scope_id": {"type": "string", "pattern": "^A-SCOPE-[0-9a-f]{64}$"},
          "question_id": {"type": "string", "pattern": "^EX-CHAPTER-[0-9a-f]{64}-[a-z][a-z0-9-]{0,63}$"},
          "scope_kind": {"enum": ["QUESTION_PROMPT", "ANSWER_SECTION"]},
          "section": {"enum": ["question_prompt", "worked_steps", "progressive_hints", "common_mistakes", "rubric", "acceptable_tradeoffs"]},
          "fragment_occurrence_ids": {"type": "array", "items": {"type": "string", "pattern": "^A-OCC-[0-9a-f]{64}$"}},
          "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "outcome": {"enum": ["FOLLOWABLE_FOR_BEGINNER", "NEEDS_REVISION", "UNABLE_TO_ASSESS"]},
          "findings": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["issue_code", "severity", "recommended_action", "location_id"],
              "properties": {
                "issue_code": {"enum": ["UNDEFINED_JARGON", "MISSING_PREREQUISITE", "ANSWER_NOT_DIRECT", "REASONING_GAP", "HINT_PROGRESSION_WEAK", "MISTAKE_UNEXPLAINED", "RUBRIC_NOT_OBSERVABLE", "TRADEOFF_UNCLEAR", "OTHER_BEGINNER_BARRIER"]},
                "severity": {"enum": ["BLOCKER", "MAJOR", "MINOR"]},
                "recommended_action": {"enum": ["DEFINE_TERM_BEFORE_USE", "ADD_PREREQUISITE", "ANSWER_QUESTION_FIRST", "EXPLAIN_MISSING_STEP", "STRENGTHEN_HINT_SEQUENCE", "EXPLAIN_FAILURE_CAUSE", "MAKE_CRITERION_OBSERVABLE", "EXPLAIN_OR_REMOVE_TRADEOFF", "NO_CHANGE"]},
                "location_id": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
