{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/coverage.schema.json",
  "title": "Project DeepDive v1 Repository Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "repository_revision", "generated_at", "tracked_file_count", "unknown_count", "entries"],
  "properties": {
    "artifact_kind": {"const": "coverage"},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "repository_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "classification_policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "tracked_file_count": {"type": "integer", "minimum": 0},
    "unknown_count": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "surface", "classification", "teaching_status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "surface": {"enum": ["backend", "frontend", "domain", "api", "agent", "database", "migration", "test", "fixture", "configuration", "environment", "infrastructure", "build", "script", "cli", "mcp", "ci", "tooling", "documentation", "asset", "lockfile", "generated", "vendor", "other"]},
          "classification": {"enum": ["UNKNOWN", "COVERED", "CLASSIFIED", "GENERATED", "VENDOR", "IGNORED_WITH_REASON"]},
          "teaching_status": {"enum": ["NOT_STARTED", "LOCATED", "TAUGHT", "VERIFIED", "NOT_APPLICABLE"]},
          "reason": {"type": "string", "minLength": 1},
          "secondary_surfaces": {
            "type": "array",
            "items": {"enum": ["backend", "frontend", "domain", "api", "agent", "database", "migration", "test", "fixture", "configuration", "environment", "infrastructure", "build", "script", "cli", "mcp", "ci", "tooling", "documentation", "asset", "lockfile", "generated", "vendor", "other"]}
          },
          "rule_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
