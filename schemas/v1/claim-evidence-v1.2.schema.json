{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/claim-evidence-v1.2.schema.json",
  "title": "Project DeepDive v1.2 Claim Evidence Matrix",
  "description": "Authenticated documentation-bearing Phase 4C referential audit. SUPPORTED proves reference coverage only, not semantic entailment; E2 repository-documentation evidence supports only what the cited document declares, not implementation or runtime behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "repository_revision",
    "generated_at",
    "snapshot_kind",
    "source_metadata",
    "source_run",
    "phase4_inputs",
    "audit_status",
    "claims",
    "source_limits"
  ],
  "properties": {
    "artifact_kind": {
      "const": "claim-evidence"
    },
    "schema_version": {
      "const": "1.2.0"
    },
    "repository_revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "snapshot_kind": {
      "enum": [
        "worktree",
        "git-tree"
      ]
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_kind",
        "g01_status",
        "unknown_files",
        "project_index_sha256",
        "coverage_sha256"
      ],
      "properties": {
        "snapshot_kind": {
          "enum": [
            "worktree",
            "git-tree"
          ]
        },
        "g01_status": {
          "enum": [
            "PASS",
            "PARTIAL"
          ]
        },
        "unknown_files": {
          "type": "integer",
          "minimum": 0
        },
        "project_index_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "schema_version",
        "manifest_sha256",
        "status",
        "e1_audit",
        "members"
      ],
      "properties": {
        "artifact_kind": {
          "const": "phase3-run"
        },
        "schema_version": {
          "const": "1.1.0"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "PASS",
            "PARTIAL"
          ]
        },
        "e1_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "g01",
            "adapters",
            "counts",
            "limitations"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "PARTIAL"
              ]
            },
            "g01": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "before",
                "after"
              ],
              "properties": {
                "before": {
                  "enum": [
                    "PASS",
                    "PARTIAL",
                    "FAIL",
                    "NOT_RUN"
                  ]
                },
                "after": {
                  "enum": [
                    "PASS",
                    "PARTIAL",
                    "FAIL",
                    "NOT_RUN"
                  ]
                }
              }
            },
            "adapters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "python",
                "java",
                "frontend"
              ],
              "properties": {
                "python": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "version",
                    "applicable_files",
                    "analyzed_files",
                    "skipped_files",
                    "partial_files",
                    "limitations"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "PASS",
                        "PARTIAL",
                        "NOT_RUN"
                      ]
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "applicable_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "analyzed_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "skipped_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "partial_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "java": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "version",
                    "applicable_files",
                    "analyzed_files",
                    "skipped_files",
                    "partial_files",
                    "limitations"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "PASS",
                        "PARTIAL",
                        "NOT_RUN"
                      ]
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "applicable_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "analyzed_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "skipped_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "partial_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "frontend": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "version",
                    "applicable_files",
                    "analyzed_files",
                    "skipped_files",
                    "partial_files",
                    "limitations"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "PASS",
                        "PARTIAL",
                        "NOT_RUN"
                      ]
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "applicable_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "analyzed_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "skipped_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "partial_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tracked_files",
                "covered_tracked_files",
                "unknown_tracked_files",
                "analyzed_files",
                "skipped_files",
                "partial_files",
                "unreported_source_files",
                "outside_analyzer_files"
              ],
              "properties": {
                "tracked_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "covered_tracked_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown_tracked_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "analyzed_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "skipped_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "partial_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "unreported_source_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "outside_analyzer_files": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "artifact_kind",
              "schema_version",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(phase2/(project-index|coverage)\\.json|phase3a/(stack-profile|evidence)\\.json|python/(static-analysis|evidence)\\.json|java-v12/(static-analysis|evidence)\\.json|java-v13/(static-analysis|evidence)\\.json|frontend/(static-analysis|evidence)\\.json|documentation/evidence\\.json)$"
              },
              "artifact_kind": {
                "enum": [
                  "project-index",
                  "coverage",
                  "stack-profile",
                  "evidence",
                  "static-analysis"
                ]
              },
              "schema_version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "phase4_inputs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "artifact_kind",
          "schema_version",
          "sha256"
        ],
        "properties": {
          "path": {
            "enum": [
              "evidence.json",
              "knowledge-graph.json",
              "semantic-proposals.json"
            ]
          },
          "artifact_kind": {
            "enum": [
              "evidence",
              "knowledge-graph",
              "semantic-proposals"
            ]
          },
          "schema_version": {
            "enum": [
              "1.1.0",
              "1.2.0",
              "1.4.0"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "audit_status": {
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "category",
          "critical",
          "evidence_ids",
          "graph_node_ids",
          "graph_edge_ids",
          "citations",
          "resolved_evidence_levels",
          "citation_results",
          "disposition",
          "reason_codes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CLAIM-[0-9a-f]{64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "project_fact",
              "architecture",
              "call_chain",
              "runtime",
              "general"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "graph_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "graph_edge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "file",
                    "symbol"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "resolved_evidence_levels": {
            "type": "array",
            "items": {
              "enum": [
                "E0",
                "E1",
                "E2",
                "E3",
                "E4",
                "E5",
                "E6"
              ]
            }
          },
          "citation_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value",
                "resolved",
                "reason_code"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "evidence",
                    "node",
                    "edge",
                    "file",
                    "symbol"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "resolved": {
                  "type": "boolean"
                },
                "reason_code": {
                  "enum": [
                    "OK",
                    "EVIDENCE_NOT_FOUND",
                    "GRAPH_NODE_NOT_FOUND",
                    "GRAPH_EDGE_NOT_FOUND",
                    "FILE_NOT_FOUND",
                    "SYMBOL_NOT_FOUND"
                  ]
                }
              }
            }
          },
          "disposition": {
            "enum": [
              "SUPPORTED",
              "INFERENCE",
              "UNVERIFIED"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "enum": [
                "EVIDENCE_NOT_FOUND",
                "GRAPH_NODE_NOT_FOUND",
                "GRAPH_EDGE_NOT_FOUND",
                "FILE_NOT_FOUND",
                "SYMBOL_NOT_FOUND",
                "NO_QUALIFYING_EVIDENCE",
                "E6_INFERENCE",
                "PROVISIONAL_EVIDENCE_NOT_CITED"
              ]
            }
          }
        }
      }
    },
    "source_limits": {
      "const": [
        "SUPPORTED confirms referential coverage only; it does not establish semantic entailment.",
        "E2 repository-documentation evidence supports only what the cited document declares; it does not establish implementation or runtime behavior."
      ]
    }
  }
}
