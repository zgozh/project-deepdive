{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/general-review-status.schema.json",
  "title": "Phase 6D2A2 Non-Promoting General Review Status",
  "description": "Two-role review coverage and findings for one immutable D2A artifact; never promotes or verifies the teaching draft.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "review_session_id", "review_session_sha256", "review_round", "generated_at", "repository_revision", "snapshot_kind", "source_metadata", "source_status", "source_run_manifest_sha256", "unknown_files", "input_digests", "selected_unit_id", "selected_unit_origin", "selected_unit_scope", "facts_sha256", "candidate_sha256", "unit_artifact_sha256", "lesson_markdown_sha256", "answer_book_markdown_sha256", "writer_packet_sha256", "occurrence_inventory_sha256", "beginner_scope_inventory_sha256", "factuality_report_sha256", "beginner_report_sha256", "missing_roles", "writer_alias", "factuality_reviewer_alias", "beginner_reviewer_alias", "reviewer_contexts_distinct", "source_reference_inspection", "supported_fact_occurrences", "factuality_outcome", "beginner_outcome", "lesson_status", "answer_book_status", "overall_status", "epistemic_status", "general_fact_review", "beginner_review", "answer_book_review", "review_state", "finding_counts"],
  "properties": {
    "artifact_kind": {"const": "general-review-status"},
    "schema_version": {"const": "1.0.0"},
    "review_session_id": {"type": "string", "pattern": "^GENERAL-REVIEW-[0-9a-f]{64}$"},
    "review_session_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_round": {"const": 0},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_metadata": {"type": "object", "additionalProperties": false, "required": ["snapshot_kind", "g01_status", "unknown_files", "project_index_sha256", "coverage_sha256"], "properties": {"snapshot_kind": {"enum": ["worktree", "git-tree"]}, "g01_status": {"enum": ["PASS", "PARTIAL"]}, "unknown_files": {"type": "integer", "minimum": 0}, "project_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "source_status": {"enum": ["PASS", "PARTIAL"]},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknown_files": {"type": "integer", "minimum": 0},
    "input_digests": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["role", "artifact_kind", "schema_version", "sha256"], "properties": {"role": {"enum": ["phase4_base_graph", "phase4_base_evidence", "phase4_semantic_proposals", "phase4_claim_candidates", "phase4_claim_evidence", "phase4_claim_evidence_graph", "phase5_prerequisite_candidates", "phase5_prerequisite_graph", "phase5_curriculum_candidates", "phase5_curriculum"]}, "artifact_kind": {"enum": ["knowledge-graph", "evidence", "semantic-proposals", "claim-candidates", "claim-evidence", "claim-evidence-graph", "prerequisite-candidates", "prerequisite-graph", "curriculum-candidates", "curriculum"]}, "schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "selected_unit_id": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"},
    "selected_unit_origin": {"enum": ["CANDIDATE", "PREREQUISITE_PRIMER"]},
    "selected_unit_scope": {"enum": ["GENERAL_LEARNING", "PROJECT_SPECIFIC"]},
    "facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unit_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lesson_markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answer_book_markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "writer_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "occurrence_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "beginner_scope_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "factuality_report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "beginner_report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "missing_roles": {"type": "array", "items": {"enum": ["GENERAL_FACTUALITY", "BEGINNER_ANSWER"]}},
    "writer_alias": {"type": "string", "minLength": 1, "maxLength": 80},
    "factuality_reviewer_alias": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "beginner_reviewer_alias": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "reviewer_contexts_distinct": {"type": "boolean"},
    "source_reference_inspection": {"type": "boolean"},
    "supported_fact_occurrences": {"type": "integer", "minimum": 0},
    "factuality_outcome": {"enum": ["SUPPORTED_BY_AUTHORITY", "NONFACTUAL_TEACHING", "NEEDS_REVISION", "UNABLE_TO_ASSESS", "MISSING_REPORT"]},
    "beginner_outcome": {"enum": ["FOLLOWABLE_FOR_BEGINNER", "NEEDS_REVISION", "UNABLE_TO_ASSESS", "MISSING_REPORT"]},
    "lesson_status": {"const": "DRAFT"},
    "answer_book_status": {"const": "DRAFT"},
    "overall_status": {"const": "PARTIAL"},
    "epistemic_status": {"const": "UNVERIFIED_TEACHING"},
    "general_fact_review": {"const": "NOT_RUN"},
    "beginner_review": {"const": "NOT_RUN"},
    "answer_book_review": {"const": "NOT_RUN"},
    "review_state": {"enum": ["REVIEWED_DRAFT", "REPAIR_REQUIRED", "REVIEW_INCOMPLETE"]},
    "finding_counts": {"type": "object", "additionalProperties": false, "required": ["BLOCKER", "MAJOR", "MINOR"], "properties": {"BLOCKER": {"type": "integer", "minimum": 0}, "MAJOR": {"type": "integer", "minimum": 0}, "MINOR": {"type": "integer", "minimum": 0}}}
  }
}
