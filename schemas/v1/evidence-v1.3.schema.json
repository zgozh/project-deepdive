{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/evidence-v1.3.schema.json",
  "title": "Project DeepDive v1.3 Repository Documentation Evidence",
  "description": "Redacted E2 repository declarations bound to selected bytes from one Phase 2 snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "repository_revision",
    "generated_at",
    "snapshot_kind",
    "source_metadata",
    "items"
  ],
  "properties": {
    "artifact_kind": {"const": "evidence"},
    "schema_version": {"const": "1.3.0"},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_kind", "g01_status", "unknown_files", "project_index_sha256", "coverage_sha256"],
      "properties": {
        "snapshot_kind": {"enum": ["worktree", "git-tree"]},
        "g01_status": {"enum": ["PASS", "PARTIAL"]},
        "unknown_files": {"type": "integer", "minimum": 0},
        "project_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "kind", "summary", "confidence", "locator", "source_bytes"],
        "properties": {
          "id": {"type": "string", "pattern": "^EVID-[0-9a-f]{24}$"},
          "level": {"const": "E2"},
          "kind": {"const": "repository_documentation"},
          "summary": {"const": "The selected repository documentation span records a repository declaration."},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line_start", "line_end"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1}
            }
          },
          "source_bytes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file_sha256", "span_sha256", "span_bytes"],
            "properties": {
              "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "span_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "span_bytes": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
