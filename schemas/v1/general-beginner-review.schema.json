{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/general-beginner-review.schema.json",
  "title": "Phase 6D2A2 Beginner and Answer Review",
  "description": "Independent teachability and exercise-coherence judgments for fixed lesson and answer-book scopes; not a factuality attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "generated_at", "review_session_id", "review_session_sha256", "review_round", "repository_revision", "snapshot_kind", "source_run_manifest_sha256", "selected_unit_id", "selected_unit_origin", "selected_unit_scope", "facts_sha256", "candidate_sha256", "unit_artifact_sha256", "lesson_markdown_sha256", "answer_book_markdown_sha256", "writer_alias", "reviewer_alias", "reviewer_session_id", "fresh_context_isolated", "packet_sha256", "results"],
  "properties": {
    "artifact_kind": {"const": "general-beginner-review"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "review_session_id": {"type": "string", "pattern": "^GENERAL-REVIEW-[0-9a-f]{64}$"},
    "review_session_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_round": {"const": 0},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_unit_id": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"},
    "selected_unit_origin": {"enum": ["CANDIDATE", "PREREQUISITE_PRIMER"]},
    "selected_unit_scope": {"enum": ["GENERAL_LEARNING", "PROJECT_SPECIFIC"]},
    "facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unit_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lesson_markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "answer_book_markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "writer_alias": {"type": "string", "minLength": 1, "maxLength": 80},
    "reviewer_alias": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "reviewer_session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "fresh_context_isolated": {"type": "boolean"},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["scope_id", "unit_id", "scope_kind", "section", "occurrence_ids", "scope_sha256", "outcome", "findings"], "properties": {
      "scope_id": {"type": "string", "pattern": "^GL-SCOPE-[0-9a-f]{64}$"},
      "unit_id": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"},
      "scope_kind": {"enum": ["LESSON_SECTION", "ORDERED_LESSON", "ANSWER_BOOK_EXERCISE"]},
      "section": {"enum": ["intuition", "prerequisite_concepts", "concepts_in_unit", "worked_example", "common_misconception", "learning_check_question", "ordered_lesson", "answer_book_exercise"]},
      "occurrence_ids": {"type": "array", "items": {"type": "string", "pattern": "^GL-OCC-[0-9a-f]{64}$"}},
      "scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "outcome": {"enum": ["FOLLOWABLE_FOR_BEGINNER", "NEEDS_REVISION", "UNABLE_TO_ASSESS"]},
      "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["issue_code", "location_id", "severity", "recommended_action", "focus", "repair_guidance"], "properties": {
        "issue_code": {"enum": ["UNDEFINED_JARGON", "MISSING_PREREQUISITE", "UNCLEAR_EXPLANATION", "ORDER_OR_ABSTRACTION_JUMP", "QUESTION_NOT_SELF_CONTAINED", "ANSWER_NOT_RESPONSIVE", "HINT_NOT_PROGRESSIVE", "RUBRIC_NOT_ACTIONABLE"]},
        "location_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["BLOCKER", "MAJOR", "MINOR"]},
        "recommended_action": {"enum": ["DEFINE_TERM", "ADD_PREREQUISITE", "REORDER_OR_BRIDGE", "CLARIFY_EXPLANATION", "REVISE_QUESTION", "ALIGN_ANSWER", "STRENGTHEN_HINTS", "MAKE_RUBRIC_ACTIONABLE", "NO_CHANGE"]},
        "focus": {"type": "string", "minLength": 1, "maxLength": 160},
        "repair_guidance": {"type": "string", "minLength": 1, "maxLength": 240}
      }}}
    }}}
  }
}
