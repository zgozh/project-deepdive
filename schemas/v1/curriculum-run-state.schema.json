{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/curriculum-run-state.schema.json",
  "title": "Project DeepDive Curriculum Run State Revision",
  "description": "Append-only execution progress for one immutable authenticated curriculum run plan; never a quality promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind", "schema_version", "generated_at", "run_state_id", "run_plan_id",
    "run_plan_sha256", "state_revision", "previous_state_sha256", "repository_revision",
    "snapshot_kind", "source_metadata", "source_status", "source_run_manifest_sha256",
    "unknown_files", "curriculum_schema_version", "curriculum_sha256", "unit_count",
    "input_digests", "run_state", "units"
  ],
  "properties": {
    "artifact_kind": {"const": "curriculum-run-state"},
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "run_state_id": {"type": "string", "pattern": "^CURRICULUM-RUN-STATE-[0-9a-f]{64}$"},
    "run_plan_id": {"type": "string", "pattern": "^CURRICULUM-RUN-PLAN-[0-9a-f]{64}$"},
    "run_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_revision": {"type": "integer", "minimum": 1},
    "previous_state_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_kind", "g01_status", "unknown_files", "project_index_sha256", "coverage_sha256"],
      "properties": {
        "snapshot_kind": {"enum": ["worktree", "git-tree"]},
        "g01_status": {"enum": ["PASS", "PARTIAL"]},
        "unknown_files": {"type": "integer", "minimum": 0},
        "project_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_status": {"enum": ["PASS", "PARTIAL"]},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknown_files": {"type": "integer", "minimum": 0},
    "curriculum_schema_version": {"enum": ["1.1.0", "1.2.0"]},
    "curriculum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unit_count": {"type": "integer", "minimum": 2},
    "input_digests": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "artifact_kind", "schema_version", "sha256"],
        "properties": {
          "role": {"enum": ["phase4_base_graph", "phase4_base_evidence", "phase4_semantic_proposals", "phase4_claim_candidates", "phase4_claim_evidence", "phase4_claim_evidence_graph", "phase5_prerequisite_candidates", "phase5_prerequisite_graph", "phase5_curriculum_candidates", "phase5_curriculum"]},
          "artifact_kind": {"enum": ["knowledge-graph", "evidence", "semantic-proposals", "claim-candidates", "claim-evidence", "claim-evidence-graph", "prerequisite-candidates", "prerequisite-graph", "curriculum-candidates", "curriculum"]},
          "schema_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "run_state": {"enum": ["READY", "ACTIVE", "WAITING_EXTERNAL", "PARTIAL_BLOCKED", "DRAFTS_REVIEWED"]},
    "units": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["position", "unit_id", "unit_identity_sha256", "route", "plan_state", "prerequisite_ids", "reason_codes", "blocked_by", "execution_state", "attempt_id", "artifact_digests"],
        "properties": {
          "position": {"type": "integer", "minimum": 1},
          "unit_id": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"},
          "unit_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "route": {"enum": ["D2A_GENERAL_LEARNING", "PHASE6A_PROJECT_CLAIM", "UPSTREAM_REQUIRED", "BLOCKED_UNSUPPORTED"]},
          "plan_state": {"enum": ["PLANNED", "BLOCKED"]},
          "prerequisite_ids": {"type": "array", "items": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"}},
          "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "blocked_by": {"type": "array", "items": {"type": "string", "pattern": "^CURRICULUM-(UNIT|PRIMER)-[0-9a-f]{64}$"}},
          "execution_state": {"enum": ["BLOCKED_UPSTREAM", "PLANNED", "PREPARED", "BUILT_DRAFT", "AWAITING_REVIEW", "REVIEWED_DRAFT", "BLOCKED_PREREQUISITE", "BLOCKED_REVIEW"]},
          "attempt_id": {"type": ["string", "null"], "pattern": "^attempt-0001$"},
          "artifact_digests": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["role", "relative_path", "sha256"],
              "properties": {
                "role": {"enum": ["chapter_facts", "writer_packet", "chapter_markdown", "exercise_bank", "chapter_draft_status", "chapter_review_session", "evidence_report", "beginner_report", "chapter_review_status", "general_facts", "candidate", "general_unit", "lesson_markdown", "answer_book_markdown", "general_review_session", "factuality_report", "general_review_status"]},
                "relative_path": {"type": "string", "pattern": "^units/[0-9]{4}/attempt-0001/(phase6a|phase6a-review|general-prepare|general-unit|general-review)/[^/]+$"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
