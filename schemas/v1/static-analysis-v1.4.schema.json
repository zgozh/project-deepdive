{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/static-analysis-1.4.schema.json",
  "title": "Project DeepDive v1.4 Frontend Static Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "repository_revision",
    "generated_at",
    "source_metadata",
    "stack_profile_sha256",
    "phase3a_evidence_sha256",
    "analysis_status",
    "languages",
    "symbols",
    "relations",
    "roles"
  ],
  "properties": {
    "artifact_kind": {"const": "static-analysis"},
    "schema_version": {"const": "1.4.0"},
    "repository_revision": {"type": "string", "minLength": 1},
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_kind",
        "g01_status",
        "unknown_files",
        "project_index_sha256",
        "coverage_sha256"
      ],
      "properties": {
        "snapshot_kind": {"enum": ["git-tree", "worktree"]},
        "g01_status": {"enum": ["PASS", "PARTIAL"]},
        "unknown_files": {"type": "integer", "minimum": 0},
        "project_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "stack_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase3a_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_status": {"enum": ["PASS", "PARTIAL"]},
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "analysis_status", "limitations", "files"],
        "properties": {
          "language": {"enum": ["javascript", "typescript"]},
          "analysis_status": {"enum": ["PASS", "PARTIAL"]},
          "limitations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "reason"],
              "properties": {
                "code": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "status", "limitations"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "status": {"enum": ["ANALYZED", "PARTIAL", "SKIPPED"]},
                "line_count": {"type": "integer", "minimum": 1},
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["code", "reason"],
                    "properties": {
                      "code": {"type": "string", "minLength": 1},
                      "reason": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "kind",
          "name",
          "qualified_name",
          "path",
          "extraction_method",
          "certainty",
          "line_start",
          "line_end",
          "evidence_ids"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^SYM-[0-9a-f]{24}$"},
          "language": {"enum": ["javascript", "typescript"]},
          "kind": {"enum": ["module", "class", "function", "method", "constructor"]},
          "name": {"type": "string", "minLength": 1},
          "qualified_name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "extraction_method": {"const": "typescript-6.0.3-parse"},
          "certainty": {"enum": ["VERIFIED", "CANDIDATE", "UNRESOLVED"]},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^EVID-[A-Za-z0-9._:-]+$"}
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "kind",
          "source_id",
          "target_id",
          "unresolved_target",
          "path",
          "extraction_method",
          "certainty",
          "line_start",
          "line_end",
          "evidence_ids"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^REL-[0-9a-f]{24}$"},
          "language": {"enum": ["javascript", "typescript"]},
          "kind": {"enum": ["DEFINES", "IMPORTS", "EXPORTS", "USES_API"]},
          "source_id": {"type": "string", "pattern": "^SYM-[0-9a-f]{24}$"},
          "target_id": {
            "type": ["string", "null"],
            "pattern": "^SYM-[0-9a-f]{24}$"
          },
          "unresolved_target": {"type": ["string", "null"], "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "extraction_method": {"const": "typescript-6.0.3-parse"},
          "certainty": {"enum": ["VERIFIED", "CANDIDATE", "UNRESOLVED"]},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^EVID-[A-Za-z0-9._:-]+$"}
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "kind",
          "symbol_id",
          "path",
          "extraction_method",
          "certainty",
          "line_start",
          "line_end",
          "evidence_ids"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^ROLE-[0-9a-f]{24}$"},
          "language": {"enum": ["javascript", "typescript"]},
          "kind": {"enum": ["component_candidate", "hook_candidate"]},
          "symbol_id": {"type": "string", "pattern": "^SYM-[0-9a-f]{24}$"},
          "path": {"type": "string", "minLength": 1},
          "extraction_method": {"const": "typescript-6.0.3-parse"},
          "certainty": {"enum": ["CANDIDATE", "UNRESOLVED"]},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^EVID-[A-Za-z0-9._:-]+$"}
          }
        }
      }
    }
  }
}
