{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/project-index.schema.json",
  "title": "Project DeepDive v1 Project Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "repository_revision", "generated_at", "project", "file_count", "files"],
  "properties": {
    "artifact_kind": {"const": "project-index"},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "repository_revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "vcs", "dirty", "snapshot_kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "vcs": {"enum": ["git", "none", "unknown"]},
        "dirty": {"type": "boolean"},
        "snapshot_kind": {"enum": ["git-tree", "worktree"]}
      }
    },
    "file_count": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "tracked"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "tracked": {"type": "boolean"},
          "content_kind": {"enum": ["text", "binary", "symlink", "gitlink"]},
          "media_type": {"type": "string", "minLength": 1},
          "extension": {"type": "string", "pattern": "^[a-z0-9]*$"},
          "vcs_object_id": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}
        }
      }
    }
  }
}
