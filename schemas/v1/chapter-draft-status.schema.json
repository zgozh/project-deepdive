{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/chapter-draft-status.schema.json",
  "title": "Project DeepDive Phase 6A Chapter Draft Status",
  "description": "Mechanical Markdown checks only; this artifact never claims semantic verification or beginner comprehension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_kind", "schema_version", "repository_revision", "generated_at", "snapshot_kind", "source_metadata", "source_status", "source_run_manifest_sha256", "unknown_files", "chapter_id", "chapter_sha256", "chapter_facts_sha256", "chapter_status", "structural_status", "overall_status", "check_results", "errors", "semantic_entailment", "evidence_verifier", "beginner_critic", "privacy_review", "g08", "g09", "g11"],
  "properties": {
    "artifact_kind": {"const": "chapter-draft-status"},
    "schema_version": {"const": "1.0.0"},
    "repository_revision": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "snapshot_kind": {"enum": ["worktree", "git-tree"]},
    "source_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_kind", "g01_status", "unknown_files", "project_index_sha256", "coverage_sha256"],
      "properties": {
        "snapshot_kind": {"enum": ["worktree", "git-tree"]},
        "g01_status": {"enum": ["PASS", "PARTIAL"]},
        "unknown_files": {"type": "integer", "minimum": 0},
        "project_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "source_status": {"enum": ["PASS", "PARTIAL"]},
    "source_run_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unknown_files": {"type": "integer", "minimum": 0},
    "chapter_id": {"type": "string", "pattern": "^CHAPTER-[0-9a-f]{64}$"},
    "chapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chapter_facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exercise_bank_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chapter_status": {"const": "DRAFT"},
    "structural_status": {"enum": ["PASS", "FAIL"]},
    "overall_status": {"const": "PARTIAL"},
    "check_results": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_integrity", "heading_order", "claim_footnotes", "exercise_sync", "excerpt_identity"],
      "properties": {
        "reference_integrity": {"enum": ["PASS", "FAIL"]},
        "heading_order": {"enum": ["PASS", "FAIL"]},
        "claim_footnotes": {"enum": ["PASS", "FAIL"]},
        "exercise_sync": {"enum": ["PASS", "FAIL"]},
        "excerpt_identity": {"enum": ["PASS", "FAIL", "NOT_RUN"]}
      }
    },
    "errors": {"type": "array", "items": {"enum": ["MARKDOWN_FORMAT_INVALID", "HEADING_ORDER_INVALID", "CLAIM_MARKER_INVALID", "CLAIM_NOT_SUPPORTED", "FOOTNOTE_INVALID", "EXERCISE_INVALID", "EXERCISE_SYNC_INVALID", "EXCERPT_INVALID"]}},
    "semantic_entailment": {"const": "NOT_RUN"},
    "evidence_verifier": {"const": "NOT_RUN"},
    "beginner_critic": {"const": "NOT_RUN"},
    "privacy_review": {"const": "NOT_RUN"},
    "g08": {"const": "PARTIAL"},
    "g09": {"const": "PARTIAL"},
    "g11": {"const": "NOT_RUN"}
  }
}
