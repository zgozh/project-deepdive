{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-deepdive.dev/schemas/v1/evidence-v1.4.schema.json",
  "title": "Project DeepDive v1.4 Evidence Store",
  "description": "A deterministic evidence fold with Phase 3 source-run identity, member provenance, and redacted repository documentation byte metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_kind",
    "schema_version",
    "repository_revision",
    "generated_at",
    "status",
    "snapshot_kind",
    "source_metadata",
    "source_run",
    "derived_inputs",
    "items"
  ],
  "properties": {
    "artifact_kind": {
      "const": "evidence"
    },
    "schema_version": {
      "const": "1.4.0"
    },
    "repository_revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "status": {
      "enum": [
        "PASS",
        "PARTIAL"
      ]
    },
    "snapshot_kind": {
      "enum": [
        "worktree",
        "git-tree"
      ]
    },
    "source_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_kind",
        "g01_status",
        "unknown_files",
        "project_index_sha256",
        "coverage_sha256"
      ],
      "properties": {
        "snapshot_kind": {
          "enum": [
            "worktree",
            "git-tree"
          ]
        },
        "g01_status": {
          "enum": [
            "PASS",
            "PARTIAL"
          ]
        },
        "unknown_files": {
          "type": "integer",
          "minimum": 0
        },
        "project_index_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverage_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_kind",
        "schema_version",
        "manifest_sha256",
        "status",
        "e1_audit",
        "members"
      ],
      "properties": {
        "artifact_kind": {
          "const": "phase3-run"
        },
        "schema_version": {
          "const": "1.1.0"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "PASS",
            "PARTIAL"
          ]
        },
        "e1_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "g01",
            "adapters",
            "counts",
            "limitations"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "PARTIAL"
              ]
            },
            "g01": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "before",
                "after"
              ],
              "properties": {
                "before": {
                  "enum": [
                    "PASS",
                    "PARTIAL",
                    "FAIL",
                    "NOT_RUN"
                  ]
                },
                "after": {
                  "enum": [
                    "PASS",
                    "PARTIAL",
                    "FAIL",
                    "NOT_RUN"
                  ]
                }
              }
            },
            "adapters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "python",
                "java",
                "frontend"
              ],
              "properties": {
                "python": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "version",
                    "applicable_files",
                    "analyzed_files",
                    "skipped_files",
                    "partial_files",
                    "limitations"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "PASS",
                        "PARTIAL",
                        "NOT_RUN"
                      ]
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "applicable_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "analyzed_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "skipped_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "partial_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "java": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "version",
                    "applicable_files",
                    "analyzed_files",
                    "skipped_files",
                    "partial_files",
                    "limitations"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "PASS",
                        "PARTIAL",
                        "NOT_RUN"
                      ]
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "applicable_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "analyzed_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "skipped_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "partial_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "frontend": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "version",
                    "applicable_files",
                    "analyzed_files",
                    "skipped_files",
                    "partial_files",
                    "limitations"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "PASS",
                        "PARTIAL",
                        "NOT_RUN"
                      ]
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "applicable_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "analyzed_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "skipped_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "partial_files": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "limitations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tracked_files",
                "covered_tracked_files",
                "unknown_tracked_files",
                "analyzed_files",
                "skipped_files",
                "partial_files",
                "unreported_source_files",
                "outside_analyzer_files"
              ],
              "properties": {
                "tracked_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "covered_tracked_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown_tracked_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "analyzed_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "skipped_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "partial_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "unreported_source_files": {
                  "type": "integer",
                  "minimum": 0
                },
                "outside_analyzer_files": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "members": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "artifact_kind",
              "schema_version",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(phase2/(project-index|coverage)\\.json|phase3a/(stack-profile|evidence)\\.json|python/(static-analysis|evidence)\\.json|java-v12/(static-analysis|evidence)\\.json|java-v13/(static-analysis|evidence)\\.json|frontend/(static-analysis|evidence)\\.json|documentation/evidence\\.json)$"
              },
              "artifact_kind": {
                "enum": [
                  "project-index",
                  "coverage",
                  "stack-profile",
                  "evidence",
                  "static-analysis"
                ]
              },
              "schema_version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "derived_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "artifact_kind",
          "schema_version",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "artifact_kind": {
            "type": "string",
            "minLength": 1
          },
          "schema_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "kind",
          "summary",
          "confidence",
          "locator",
          "source_members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EVID-[A-Za-z0-9._:-]+$"
          },
          "level": {
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3",
              "E4",
              "E5",
              "E6"
            ]
          },
          "kind": {
            "enum": [
              "user",
              "source",
              "config",
              "dependency",
              "test",
              "runtime",
              "official_documentation",
              "history",
              "issue",
              "inference",
              "repository_documentation"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "observation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "source_members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_bytes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file_sha256",
              "span_sha256",
              "span_bytes"
            ],
            "properties": {
              "file_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "span_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "span_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
